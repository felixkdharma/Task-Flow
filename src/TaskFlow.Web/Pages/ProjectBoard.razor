@page "/projects/{Id:guid}"
@attribute [Authorize]
@layout AppLayout
@inject ProjectApiService ProjectApi
@inject WorkspaceApiService WorkspaceApi
@inject WorkBoardApiService WorkBoardApi
@inject AuthSessionService AuthSession

<PageTitle>@(_project?.ProjectName ?? "Project") | TaskFlow</PageTitle>

@if (_loading)
{
    <section class="project-page-content project-board-state" role="status">
        <span class="project-loading-spinner" aria-hidden="true"></span>
        <h1>Loading project</h1>
        <p>Getting the project workspace ready.</p>
    </section>
}
else if (_notFound)
{
    <section class="project-page-content project-board-state">
        <span class="project-state-icon" aria-hidden="true">?</span>
        <h1>Project not found</h1>
        <p>This project does not exist or is not available to your account.</p>
        <a class="project-primary-button" href="/projects">Back to projects</a>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <section class="project-page-content project-board-state" role="alert">
        <span class="project-state-icon" aria-hidden="true">!</span>
        <h1>@_loadErrorTitle</h1>
        <p>@_loadError</p>
        <button type="button" class="project-secondary-button" @onclick="LoadProjectAsync">Try again</button>
    </section>
}
else if (_project is not null)
{
    <header class="project-topbar project-board-header">
        <div>
            <a class="project-breadcrumb" href="/projects">Projects</a>
            <h1>@_project.ProjectName</h1>
            <p>@_project.Description</p>
        </div>
        <span class="project-coming-soon">Four-stage workflow</span>
    </header>

    <section class="project-page-content">
        @if (_workspace is null)
        {
            <div class="project-state-panel workspace-empty-state">
                <span class="project-state-icon" aria-hidden="true">◇</span>
                <span class="eyebrow">Project workspace</span>
                <h2>Create a workspace</h2>
                <p>This project needs a workspace before its Kanban board can be used.</p>
                <button type="button" class="project-primary-button" @onclick="OpenCreateWorkspace">
                    <span aria-hidden="true">＋</span> Create workspace
                </button>
            </div>
        }
        else
        {
            <section class="workspace-summary" aria-labelledby="workspace-title">
                <div class="workspace-summary-mark" aria-hidden="true">@WorkspaceInitial</div>
                <div class="workspace-summary-copy">
                    <span class="eyebrow">Workspace</span>
                    <h2 id="workspace-title">@_workspace.WorkspaceName</h2>
                    <p>@WorkspaceDescription</p>
                </div>
                <div class="workspace-summary-actions">
                    <button type="button" class="project-secondary-button" @onclick="OpenEditWorkspace">Edit</button>
                    <button type="button" class="workspace-delete-button" @onclick="OpenDeleteWorkspace">Delete</button>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(_workBoardLoadError))
            {
                <div class="workboard-alert" role="alert">
                    <span>@_workBoardLoadError</span>
                    <button type="button" @onclick="LoadWorkBoardsAsync">Try again</button>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_workBoardOperationError))
            {
                <div class="workboard-alert" role="alert">
                    <span>@_workBoardOperationError</span>
                    <button type="button" @onclick="ClearWorkBoardError" aria-label="Dismiss">×</button>
                </div>
            }

            <div class="kanban-board workspace-kanban" aria-label="@($"{_workspace.WorkspaceName} workflow")" aria-busy="@_workBoardsLoading">
                @foreach (var column in Columns)
                {
                    var cards = CardsFor(column.Status).ToList();
                    <section class="kanban-column @(_draggedWorkBoardId.HasValue ? "kanban-drop-ready" : null)" data-kanban-column="@column.Status"
                             @ondragover:preventDefault="true" @ondrop="@(() => DropWorkBoardAsync(column.Status))">
                        <header>
                            <div><h2>@column.Name</h2><span>@cards.Count</span></div>
                            <button type="button" class="kanban-add-button" @onclick="@(() => OpenCreateWorkBoard(column.Status))">
                                <span aria-hidden="true">＋</span> Add
                            </button>
                        </header>
                        <div class="kanban-column-body">
                            @if (_workBoardsLoading)
                            {
                                <div class="kanban-column-loading"><span class="project-loading-spinner"></span></div>
                            }
                            else if (cards.Count == 0)
                            {
                                <div class="kanban-empty-column">
                                    <span aria-hidden="true">＋</span>
                                    <p>No workboards yet</p>
                                    <small>Add a workboard here or drag one into this column.</small>
                                </div>
                            }
                            else
                            {
                                @foreach (var card in cards)
                                {
                                    <article @key="card.WorkBoardId"
                                             class="kanban-card @(_movingWorkBoards.Contains(card.WorkBoardId) ? "is-moving" : null)"
                                             draggable="@(_movingWorkBoards.Contains(card.WorkBoardId) ? "false" : "true")"
                                             data-workboard-card data-workboard-id="@card.WorkBoardId"
                                             aria-label="@($"{card.WorkBoardName} workboard")"
                                             aria-disabled="@(_movingWorkBoards.Contains(card.WorkBoardId) ? "true" : "false")"
                                             @ondragstart="@(() => BeginDrag(card))" @ondragend="EndDrag">
                                        <div class="kanban-card-header">
                                            <strong>@card.WorkBoardName</strong>
                                            <button type="button" class="kanban-card-edit"
                                                    @onclick="@(() => OpenEditWorkBoard(card))"
                                                    disabled="@_movingWorkBoards.Contains(card.WorkBoardId)">
                                                Edit
                                            </button>
                                        </div>
                                        <span class="kanban-card-description">@CardDescription(card)</span>
                                        <span class="kanban-card-dates">
                                            <span aria-hidden="true">◷</span>
                                            @FormatDateRange(card)
                                        </span>
                                    </article>
                                }
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </section>
}

@if (_showWorkspaceForm)
{
    <div class="project-modal-backdrop" @onclick="CloseWorkspaceForm">
        <section class="project-modal" role="dialog" aria-modal="true" aria-labelledby="workspace-form-title" @onclick:stopPropagation="true">
            <header class="project-modal-header">
                <div>
                    <span class="eyebrow">@(_editingWorkspace ? "Workspace settings" : "New workspace")</span>
                    <h2 id="workspace-form-title">@(_editingWorkspace ? "Edit workspace" : "Create a workspace")</h2>
                </div>
                <button type="button" class="project-modal-close" @onclick="CloseWorkspaceForm" aria-label="Close">×</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="project-form-alert" role="alert">@_formError</div>
            }

            <EditForm Model="_workspaceForm" OnValidSubmit="SaveWorkspaceAsync" FormName="workspace-form">
                <DataAnnotationsValidator />
                <div class="project-field">
                    <label for="workspace-name">Workspace name</label>
                    <input id="workspace-name" @bind="_workspaceForm.WorkspaceName" @bind:event="oninput"
                           maxlength="100" autocomplete="off" placeholder="Main workspace" autofocus />
                    <ValidationMessage For="@(() => _workspaceForm.WorkspaceName)" />
                </div>
                <div class="project-field">
                    <label for="workspace-description">Description <span class="project-optional-label">Optional</span></label>
                    <textarea id="workspace-description" @bind="_workspaceForm.WorkspaceDescription" @bind:event="oninput"
                              rows="5" placeholder="What will your team manage here?"></textarea>
                </div>
                <footer class="project-modal-actions">
                    <button type="button" class="project-secondary-button" @onclick="CloseWorkspaceForm" disabled="@_submitting">Cancel</button>
                    <button type="submit" class="project-primary-button" disabled="@_submitting">
                        @if (_submitting)
                        {
                            <span class="button-spinner"></span><span>Saving…</span>
                        }
                        else
                        {
                            <span>@(_editingWorkspace ? "Save changes" : "Create workspace")</span>
                        }
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@if (_showDeleteWorkspace && _workspace is not null)
{
    <div class="project-modal-backdrop" @onclick="CloseDeleteWorkspace">
        <section class="project-modal workspace-delete-modal" role="alertdialog" aria-modal="true"
                 aria-labelledby="delete-workspace-title" aria-describedby="delete-workspace-description" @onclick:stopPropagation="true">
            <header class="project-modal-header">
                <div><span class="eyebrow">Delete workspace</span><h2 id="delete-workspace-title">Delete @_workspace.WorkspaceName?</h2></div>
                <button type="button" class="project-modal-close" @onclick="CloseDeleteWorkspace" aria-label="Close">×</button>
            </header>
            <p id="delete-workspace-description">This removes the workspace from the project. This action cannot be undone.</p>
            @if (!string.IsNullOrWhiteSpace(_deleteError))
            {
                <div class="project-form-alert" role="alert">@_deleteError</div>
            }
            <footer class="project-modal-actions">
                <button type="button" class="project-secondary-button" @onclick="CloseDeleteWorkspace" disabled="@_submitting">Cancel</button>
                <button type="button" class="workspace-danger-button" @onclick="DeleteWorkspaceAsync" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="button-spinner"></span><span>Deleting…</span>
                    }
                    else
                    {
                        <span>Delete workspace</span>
                    }
                </button>
            </footer>
        </section>
    </div>
}

@if (_showWorkBoardForm && _workspace is not null)
{
    <div class="project-modal-backdrop" @onclick="CloseWorkBoardForm">
        <section class="project-modal" role="dialog" aria-modal="true" aria-labelledby="workboard-form-title" @onclick:stopPropagation="true">
            <header class="project-modal-header">
                <div>
                    <span class="eyebrow">@(_editingWorkBoardId.HasValue ? "Workboard details" : ColumnName(_workBoardFormStatus))</span>
                    <h2 id="workboard-form-title">@(_editingWorkBoardId.HasValue ? "Edit workboard" : "Add workboard")</h2>
                </div>
                <button type="button" class="project-modal-close" @onclick="CloseWorkBoardForm" aria-label="Close">×</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(_workBoardFormError))
            {
                <div class="project-form-alert" role="alert">@_workBoardFormError</div>
            }

            <EditForm Model="_workBoardForm" OnValidSubmit="SaveWorkBoardAsync" FormName="workboard-form">
                <DataAnnotationsValidator />
                <div class="project-field">
                    <label for="workboard-name">Workboard name</label>
                    <input id="workboard-name" @bind="_workBoardForm.WorkBoardName" @bind:event="oninput"
                           maxlength="200" autocomplete="off" placeholder="Prepare release notes" autofocus />
                    <ValidationMessage For="@(() => _workBoardForm.WorkBoardName)" />
                </div>
                <div class="project-field">
                    <label for="workboard-description">Description <span class="project-optional-label">Optional</span></label>
                    <textarea id="workboard-description" @bind="_workBoardForm.WorkBoardDescription" @bind:event="oninput"
                              maxlength="200" rows="4" placeholder="Add context for this workboard."></textarea>
                    <div class="project-field-footer">
                        <ValidationMessage For="@(() => _workBoardForm.WorkBoardDescription)" />
                        <small>@_workBoardForm.WorkBoardDescription.Length / 200</small>
                    </div>
                </div>
                <div class="workboard-date-grid">
                    <div class="project-field">
                        <label for="workboard-start-date">Start date</label>
                        <InputDate id="workboard-start-date" @bind-Value="_workBoardForm.StartDate" />
                        <ValidationMessage For="@(() => _workBoardForm.StartDate)" />
                    </div>
                    <div class="project-field">
                        <label for="workboard-end-date">End date</label>
                        <InputDate id="workboard-end-date" @bind-Value="_workBoardForm.EndDate" />
                        <ValidationMessage For="@(() => _workBoardForm.EndDate)" />
                    </div>
                </div>
                <footer class="project-modal-actions">
                    <button type="button" class="project-secondary-button" @onclick="CloseWorkBoardForm" disabled="@_workBoardSubmitting">Cancel</button>
                    <button type="submit" class="project-primary-button" disabled="@_workBoardSubmitting">
                        @if (_workBoardSubmitting)
                        {
                            <span class="button-spinner"></span><span>Saving…</span>
                        }
                        else
                        {
                            <span>@(_editingWorkBoardId.HasValue ? "Save changes" : $"Add to {ColumnName(_workBoardFormStatus)}")</span>
                        }
                    </button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private static readonly WorkBoardColumn[] Columns =
    [
        new("Backlog", 99),
        new("To do", 1),
        new("In progress", 2),
        new("Complete", 100)
    ];
    private static readonly HashSet<int> KnownStatuses = Columns.Select(column => column.Status).ToHashSet();
    private ProjectResponse? _project;
    private WorkspaceResponse? _workspace;
    private List<WorkBoardResponse> _workBoards = [];
    private WorkspaceFormModel _workspaceForm = new();
    private WorkBoardFormModel _workBoardForm = new();
    private readonly HashSet<Guid> _movingWorkBoards = [];
    private bool _loading = true;
    private bool _notFound;
    private bool _showWorkspaceForm;
    private bool _showDeleteWorkspace;
    private bool _showWorkBoardForm;
    private bool _editingWorkspace;
    private bool _submitting;
    private bool _workBoardsLoading;
    private bool _workBoardSubmitting;
    private Guid? _editingWorkBoardId;
    private Guid? _draggedWorkBoardId;
    private int _workBoardFormStatus = 99;
    private string _loadErrorTitle = "Project could not be loaded";
    private string? _loadError;
    private string? _formError;
    private string? _deleteError;
    private string? _workBoardLoadError;
    private string? _workBoardOperationError;
    private string? _workBoardFormError;

    private string WorkspaceDescription => string.IsNullOrWhiteSpace(_workspace?.WorkspaceDescription)
        ? "No description has been added yet."
        : _workspace.WorkspaceDescription;

    private string WorkspaceInitial => string.IsNullOrWhiteSpace(_workspace?.WorkspaceName)
        ? "W"
        : char.ToUpperInvariant(_workspace.WorkspaceName.Trim()[0]).ToString();

    protected override Task OnParametersSetAsync() => LoadProjectAsync();

    private async Task LoadProjectAsync()
    {
        _loading = true;
        _notFound = false;
        _loadError = null;
        _loadErrorTitle = "Project could not be loaded";
        _workBoards = [];
        _workBoardLoadError = null;
        _workBoardOperationError = null;
        try
        {
            _project = await ProjectApi.GetProjectAsync(Id);
            _notFound = _project is null;
            if (_notFound)
            {
                _workspace = null;
                return;
            }

            var workspaces = await WorkspaceApi.GetWorkspacesAsync(Id);
            _workspace = workspaces.FirstOrDefault();
            if (_workspace is not null)
            {
                await LoadWorkBoardsAsync();
            }
        }
        catch (ProjectApiException exception)
        {
            SetLoadError(exception.StatusCode, exception.Message);
        }
        catch (WorkspaceApiException exception)
        {
            SetLoadError(exception.StatusCode, exception.Message, "Workspace could not be loaded");
        }
        catch
        {
            _loadError = "TaskFlow could not connect to the server. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWorkBoardsAsync()
    {
        if (_workspace is null)
        {
            _workBoards = [];
            return;
        }

        _workBoardsLoading = true;
        _workBoardLoadError = null;
        try
        {
            _workBoards = (await WorkBoardApi.GetWorkBoardsAsync(Id, _workspace.WorkspaceId)).ToList();
            SortWorkBoards();
            if (_workBoards.Any(workBoard => !KnownStatuses.Contains(workBoard.WorkBoardStatus)))
            {
                _workBoardOperationError = "Some older workboards had an unknown status and are shown in Backlog. Move them to save a valid status.";
            }
        }
        catch (WorkBoardApiException exception)
        {
            _workBoardLoadError = WorkBoardErrorMessage(exception);
        }
        catch
        {
            _workBoardLoadError = "TaskFlow could not load the workboards. Please try again.";
        }
        finally
        {
            _workBoardsLoading = false;
        }
    }

    private void SetLoadError(int statusCode, string message, string defaultTitle = "Project could not be loaded")
    {
        _loadErrorTitle = statusCode == 401 ? "Your session has expired" : defaultTitle;
        _loadError = statusCode == 401 ? "Sign in again to continue working in TaskFlow." : message;
    }

    private void OpenCreateWorkspace()
    {
        _editingWorkspace = false;
        _workspaceForm = new WorkspaceFormModel();
        _formError = null;
        _showWorkspaceForm = true;
    }

    private void OpenEditWorkspace()
    {
        if (_workspace is null)
        {
            return;
        }

        _editingWorkspace = true;
        _workspaceForm = new WorkspaceFormModel
        {
            WorkspaceName = _workspace.WorkspaceName,
            WorkspaceDescription = _workspace.WorkspaceDescription ?? string.Empty
        };
        _formError = null;
        _showWorkspaceForm = true;
    }

    private void CloseWorkspaceForm()
    {
        if (!_submitting)
        {
            _showWorkspaceForm = false;
        }
    }

    private async Task SaveWorkspaceAsync()
    {
        var user = AuthSession.CurrentUser;
        if (user is null)
        {
            _formError = "Your session has expired. Sign in again to continue.";
            return;
        }

        _submitting = true;
        _formError = null;
        try
        {
            _workspace = _editingWorkspace && _workspace is not null
                ? await WorkspaceApi.UpdateWorkspaceAsync(_workspace.WorkspaceId, Id, user.Id, _workspaceForm)
                : await WorkspaceApi.CreateWorkspaceAsync(Id, user.Id, _workspaceForm);
            if (!_editingWorkspace)
            {
                _workBoards = [];
                _workBoardLoadError = null;
                _workBoardOperationError = null;
            }
            _showWorkspaceForm = false;
        }
        catch (WorkspaceApiException exception)
        {
            _formError = exception.StatusCode == 401
                ? "Your session has expired. Sign in again to continue."
                : exception.Message;
        }
        catch
        {
            _formError = "TaskFlow could not connect to the server. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OpenDeleteWorkspace()
    {
        _deleteError = null;
        _showDeleteWorkspace = true;
    }

    private void CloseDeleteWorkspace()
    {
        if (!_submitting)
        {
            _showDeleteWorkspace = false;
        }
    }

    private async Task DeleteWorkspaceAsync()
    {
        if (_workspace is null)
        {
            return;
        }

        _submitting = true;
        _deleteError = null;
        try
        {
            var deleted = await WorkspaceApi.DeleteWorkspaceAsync(Id, _workspace.WorkspaceId);
            if (!deleted)
            {
                _deleteError = "This workspace no longer exists. Reload the project and try again.";
                return;
            }

            _workspace = null;
            _workBoards = [];
            _showDeleteWorkspace = false;
        }
        catch (WorkspaceApiException exception)
        {
            _deleteError = exception.StatusCode == 401
                ? "Your session has expired. Sign in again to continue."
                : exception.Message;
        }
        catch
        {
            _deleteError = "TaskFlow could not connect to the server. Please try again.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private IEnumerable<WorkBoardResponse> CardsFor(int status)
    {
        return status == 99
            ? _workBoards.Where(workBoard => workBoard.WorkBoardStatus == status || !KnownStatuses.Contains(workBoard.WorkBoardStatus))
            : _workBoards.Where(workBoard => workBoard.WorkBoardStatus == status);
    }

    private void OpenCreateWorkBoard(int status)
    {
        _editingWorkBoardId = null;
        _workBoardFormStatus = status;
        _workBoardForm = new WorkBoardFormModel();
        _workBoardFormError = null;
        _showWorkBoardForm = true;
    }

    private void OpenEditWorkBoard(WorkBoardResponse workBoard)
    {
        if (_movingWorkBoards.Contains(workBoard.WorkBoardId))
        {
            return;
        }

        _editingWorkBoardId = workBoard.WorkBoardId;
        _workBoardFormStatus = KnownStatuses.Contains(workBoard.WorkBoardStatus) ? workBoard.WorkBoardStatus : 99;
        _workBoardForm = new WorkBoardFormModel
        {
            WorkBoardName = workBoard.WorkBoardName,
            WorkBoardDescription = workBoard.WorkBoardDescription ?? string.Empty,
            StartDate = workBoard.StartDate.Date,
            EndDate = workBoard.EndDate.Date
        };
        _workBoardFormError = null;
        _showWorkBoardForm = true;
    }

    private void CloseWorkBoardForm()
    {
        if (!_workBoardSubmitting)
        {
            _showWorkBoardForm = false;
        }
    }

    private async Task SaveWorkBoardAsync()
    {
        if (_workspace is null)
        {
            _workBoardFormError = "The workspace is no longer available. Reload the project and try again.";
            return;
        }

        _workBoardSubmitting = true;
        _workBoardFormError = null;
        try
        {
            if (_editingWorkBoardId is Guid workBoardId)
            {
                var updated = await WorkBoardApi.UpdateWorkBoardAsync(
                    workBoardId,
                    Id,
                    _workspace.WorkspaceId,
                    _workBoardForm);
                ReplaceWorkBoard(updated);
            }
            else
            {
                var created = await WorkBoardApi.CreateWorkBoardAsync(
                    Id,
                    _workspace.WorkspaceId,
                    _workBoardFormStatus,
                    _workBoardForm);
                _workBoards.Add(created);
            }

            SortWorkBoards();
            _showWorkBoardForm = false;
            _workBoardOperationError = null;
        }
        catch (WorkBoardApiException exception)
        {
            _workBoardFormError = WorkBoardErrorMessage(exception);
        }
        catch
        {
            _workBoardFormError = "TaskFlow could not save the workboard. Please try again.";
        }
        finally
        {
            _workBoardSubmitting = false;
        }
    }

    private void BeginDrag(WorkBoardResponse workBoard)
    {
        if (!_movingWorkBoards.Contains(workBoard.WorkBoardId))
        {
            _draggedWorkBoardId = workBoard.WorkBoardId;
            _workBoardOperationError = null;
        }
    }

    private void EndDrag()
    {
        _draggedWorkBoardId = null;
    }

    private async Task DropWorkBoardAsync(int status)
    {
        if (_workspace is null || _draggedWorkBoardId is not Guid workBoardId)
        {
            return;
        }

        _draggedWorkBoardId = null;
        var index = _workBoards.FindIndex(workBoard => workBoard.WorkBoardId == workBoardId);
        if (index < 0 || _movingWorkBoards.Contains(workBoardId))
        {
            return;
        }

        var original = _workBoards[index];
        if (original.WorkBoardStatus == status)
        {
            return;
        }

        _movingWorkBoards.Add(workBoardId);
        _workBoards[index] = original with { WorkBoardStatus = status };
        _workBoardOperationError = null;
        try
        {
            var savedStatus = await WorkBoardApi.UpdateStatusAsync(
                workBoardId,
                Id,
                _workspace.WorkspaceId,
                status);
            _workBoards[index] = _workBoards[index] with { WorkBoardStatus = savedStatus };
            SortWorkBoards();
        }
        catch (WorkBoardApiException exception)
        {
            ReplaceWorkBoard(original);
            _workBoardOperationError = $"{original.WorkBoardName} was returned to {ColumnName(original.WorkBoardStatus)}. {WorkBoardErrorMessage(exception)}";
        }
        catch
        {
            ReplaceWorkBoard(original);
            _workBoardOperationError = $"{original.WorkBoardName} was returned to {ColumnName(original.WorkBoardStatus)} because TaskFlow could not save the move.";
        }
        finally
        {
            _movingWorkBoards.Remove(workBoardId);
        }
    }

    private void ReplaceWorkBoard(WorkBoardResponse workBoard)
    {
        var index = _workBoards.FindIndex(item => item.WorkBoardId == workBoard.WorkBoardId);
        if (index >= 0)
        {
            _workBoards[index] = workBoard;
        }
    }

    private void SortWorkBoards()
    {
        _workBoards = _workBoards
            .OrderBy(workBoard => workBoard.WorkBoardName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ClearWorkBoardError() => _workBoardOperationError = null;

    private static string ColumnName(int status) =>
        Columns.FirstOrDefault(column => column.Status == status)?.Name ?? "Backlog";

    private static string CardDescription(WorkBoardResponse workBoard) =>
        string.IsNullOrWhiteSpace(workBoard.WorkBoardDescription)
            ? "No description"
            : workBoard.WorkBoardDescription;

    private static string FormatDateRange(WorkBoardResponse workBoard) =>
        workBoard.StartDate.Date == workBoard.EndDate.Date
            ? workBoard.StartDate.ToString("MMM d, yyyy")
            : $"{workBoard.StartDate:MMM d} – {workBoard.EndDate:MMM d, yyyy}";

    private static string WorkBoardErrorMessage(WorkBoardApiException exception) => exception.StatusCode switch
    {
        401 => "Your session has expired. Sign in again to continue.",
        404 => "This workboard is no longer available to your account.",
        _ => exception.Message
    };

    private sealed record WorkBoardColumn(string Name, int Status);
}
